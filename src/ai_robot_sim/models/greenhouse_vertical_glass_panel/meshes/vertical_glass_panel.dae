<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1" />
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="vertical_glass_panel">
      <mesh>
        <source id="vertical_glass_positions">
          <float_array id="vertical_glass_positions_array" count="24">-0.5 -0.5 -0.5 -0.5 0.5 -0.5 -0.5 0.5 0.5 -0.5 -0.5 0.5 0.5 -0.5 -0.5 0.5 0.5 -0.5 0.5 0.5 0.5 0.5 -0.5 0.5</float_array>
          <technique_common>
            <accessor source="#vertical_glass_positions_array" count="8" stride="3">
              <param name="X" type="float" />
              <param name="Y" type="float" />
              <param name="Z" type="float" />
            </accessor>
          </technique_common>
        </source>
        <vertices id="vertical_glass_vertices">
          <input semantic="POSITION" source="#vertical_glass_positions" />
        </vertices>
        <triangles count="12">
          <input semantic="VERTEX" source="#vertical_glass_vertices" offset="0" />
          <p>0 3 2 0 2 1 4 5 6 4 6 7 0 1 5 0 5 4 1 2 6 1 6 5 2 3 7 2 7 6 3 0 4 3 4 7</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene">
      <node id="vertical-glass-panel-node">
        <instance_geometry url="#vertical_glass_panel" />
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene" />
  </scene>
</COLLADA>

        <material><ambient>0.48 0.51 0.54 1</ambient><diffuse>0.58 0.61 0.64 1</diffuse></material>
      </visual>
      <!-- RPLIDAR S2 installation: scan-plane center at base_link Z=0.660 m.
           Vendor housing dimensions were not supplied; the visible cylindrical envelope is schematic. -->
      <visual name="lidar_mount_plate">
        <pose>0 0 0.565 0 0 0</pose><geometry><box><size>0.080 0.080 0.008</size></box></geometry>
        <material><ambient>0.10 0.11 0.12 1</ambient><diffuse>0.14 0.15 0.16 1</diffuse></material>
      </visual>

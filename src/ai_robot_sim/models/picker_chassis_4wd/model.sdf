      <visual name="camera_yaw_turntable">
        <pose>0.650 0 0.305 0 0 0</pose><geometry><box><size>0.090 0.090 0.010</size></box></geometry>
        <material><ambient>0.12 0.13 0.14 1</ambient><diffuse>0.18 0.19 0.20 1</diffuse></material>

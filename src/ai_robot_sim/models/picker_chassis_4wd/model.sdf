    <plugin name="picker_4wd_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/picker_test</namespace>
      </ros>
      <update_rate>100</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>drive_front_left_joint</left_joint>
      <right_joint>drive_front_right_joint</right_joint>
      <wheel_separation>0.55</wheel_separation>
      <left_joint>drive_rear_left_joint</left_joint>
      <right_joint>drive_rear_right_joint</right_joint>
      <wheel_separation>0.55</wheel_separation>
      <wheel_diameter>0.248</wheel_diameter>
      <wheel_diameter>0.248</wheel_diameter>
      <max_wheel_torque>40</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
    <plugin name="picker_4wd_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/picker_test</namespace>
      </ros>
      <update_rate>100</update_rate>
      <joint_name>drive_front_left_joint</joint_name>
      <joint_name>drive_front_right_joint</joint_name>
      <joint_name>drive_rear_left_joint</joint_name>
      <joint_name>drive_rear_right_joint</joint_name>
    </plugin>

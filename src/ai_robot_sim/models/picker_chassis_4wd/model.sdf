<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
  <model name="picker_chassis_4wd">
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.16 0 0 0</pose>
        <mass>60</mass>
        <inertia>
          <ixx>3.26</ixx>
          <iyy>10.25</iyy>
          <izz>12.61</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="blue_shell">
        <geometry>
          <mesh>
            <uri>model://picker_chassis_4wd/meshes/base_link_blue_shell.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.03 0.32 0.76 1</ambient>
          <diffuse>0.03 0.32 0.76 1</diffuse>
        </material>
      </visual>
      <visual name="metal_top">

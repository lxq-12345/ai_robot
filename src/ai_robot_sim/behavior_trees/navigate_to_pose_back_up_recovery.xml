<!--
  AU9 apartment navigation recovery policy for doorways and other obstacles.

  A doorway failure must first create room by reversing.  In particular, do
  not run Nav2's Spin recovery while the rectangular robot is still between
  the jambs.  After a successful short backup, both costmaps are cleared and
  the navigation pipeline replans before trying the route again.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="BackUpReplanBeforeControllerRetry">
            <Fallback name="BackUpIfSafe-Context">
              <BackUp backup_dist="0.20" backup_speed="0.05"/>
              <AlwaysSuccess/>
            </Fallback>
            <ClearEntireCostmap name="ClearLocalCostmap-AfterBackUp" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-AfterBackUp" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="BackUpAndReplan">
          <Fallback name="BackUpIfSafe-Subtree">
            <BackUp backup_dist="0.20" backup_speed="0.05"/>
            <AlwaysSuccess/>
          </Fallback>
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>

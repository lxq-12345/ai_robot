    <joint name="drive_front_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>drive_front_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.04</damping>

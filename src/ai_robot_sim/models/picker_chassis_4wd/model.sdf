        <material>
          <ambient>0.12 0.13 0.15 1</ambient>
          <diffuse>0.12 0.13 0.15 1</diffuse>
        </material>
      </visual>
      <!-- Yellow top deck and sensor installation appearance, based on picker chassis v0.7.
           These are visual-only approximations; chassis collision and dynamics are unchanged. -->
      <visual name="yellow_top_plate">
        <pose>0 0 0.297 0 0 0</pose>
        <geometry><box><size>1.400 0.750 0.006</size></box></geometry>
        <material><ambient>0.92 0.62 0.02 1</ambient><diffuse>0.98 0.70 0.02 1</diffuse></material>
      </visual>
      <visual name="server_mount_foot_front_left">
        <pose>0.160 0.110 0.305 0 0 0</pose><geometry><box><size>0.030 0.030 0.010</size></box></geometry>
        <material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.32 0.34 0.36 1</diffuse></material>
      </visual>
      <visual name="server_mount_foot_front_right">
        <pose>0.160 -0.110 0.305 0 0 0</pose><geometry><box><size>0.030 0.030 0.010</size></box></geometry>
        <material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.32 0.34 0.36 1</diffuse></material>

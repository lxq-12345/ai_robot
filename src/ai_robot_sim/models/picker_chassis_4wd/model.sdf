    <link name="drive_front_left">
      <pose>0.450 0.275 0.050 0 0 0</pose>
      <inertial>
        <pose>0 0.04 0 0 0 0</pose>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.02</iyy>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Local Gazebo/Nav2 sessions only. All ROS participants in the session
     must load this profile. Keep hardware and remote deployments separate. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>au9_udp_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="au9_local_simulation" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>au9_udp_loopback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
